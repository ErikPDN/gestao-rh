{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": [
      "vitest/globals",
      "node"
    ],
    "paths": {
      "@app/common": [
        "./libs/common/src"
      ],
      "@app/common/*": [
        "./libs/common/src/*"
      ],
      "@app/contracts": [
        "./libs/contracts/src"
      ],
      "@app/contracts/*": [
        "./libs/contracts/src/*"
      ],
      "@app/proto": [
        "./libs/proto/src"
      ],
      "@app/proto/*": [
        "./libs/proto/src/*"
      ]
    }
  },
  "files": [],
  "references": [
    {
      "path": "./apps/funcionarios/tsconfig.app.json"
    },
    {
      "path": "./apps/gateway/tsconfig.app.json"
    },
    {
      "path": "./apps/gestao-rh/tsconfig.app.json"
    },
    {
      "path": "./apps/departamento/tsconfig.app.json"
    }
  ]
}