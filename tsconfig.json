{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": ["vitest/globals", "node"],
    "paths": {
      "@app/common": ["./libs/common/src/index.ts"],
      "@app/common/*": ["./libs/common/src/*"],
      "@app/contracts": ["./libs/contracts/src/index.ts"],
      "@app/contracts/*": ["./libs/contracts/src/*"],
      "@app/proto": ["./libs/proto/src/index.ts"],
      "@app/proto/*": ["./libs/proto/src/*"]
    }
  },
  "files": [],
  "references": [
    {
      "path": "./apps/funcionarios/tsconfig.app.json"
    },
    {
      "path": "./apps/api-gateway/tsconfig.app.json"
    },
    {
      "path": "./apps/departamentos/tsconfig.app.json"
    }
  ]
}
