DB_USERNAME_AUTH=postgres
DB_PASSWORD_AUTH=postgres
DB_HOST_AUTH=localhost
DB_PORT_AUTH=5432
DB_AUTH=gestao_rh_auth
FUNCIONARIO_GRPC_URL=localhost:50052
